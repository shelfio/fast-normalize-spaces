{
  "name": "@shelf/fast-normalize-spaces",
  "version": "2.1.0",
  "description": "A faster (by 16-70%) implementation of \"normalize-space-x\" package that uses at least 3x less RAM",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "author": {
    "name": "Vlad Holubiev",
    "email": "vlad@shelf.io",
    "url": "https://shelf.io"
  },
  "sideEffects": false,
  "type": "module",
  "exports": "./lib/index.js",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "benchmark": "pnpm benchmark:memory && pnpm benchmark:speed",
    "benchmark:memory": "pnpm build && node benchmark/memory/test.js",
    "benchmark:speed": "pnpm build && node benchmark/speed/test.js",
    "build": "rm -rf lib/ && tsc",
    "coverage": "pnpm test --coverage",
    "lint": "oxfmt && eslint . --fix",
    "lint:ci": "oxfmt --check && eslint .",
    "prepack": "pnpm build",
    "test": "TZ=UTC jest src",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch"
  },
  "lint-staged": {
    "*.{html,md,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,ts,json}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@shelf/eslint-config": "7.1.0",
    "@shelf/prettier-config": "1.1.1",
    "@shelf/tsconfig": "0.2.0",
    "@swc/core": "1.13.5",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.6",
    "benny": "3.7.1",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "lint-staged": "16.4.0",
    "normalize-space-x": "4.1.2",
    "oxfmt": "0.64.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
